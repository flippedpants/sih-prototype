{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SourceMapping",
  "type": "object",
  "required": [
    "source_type",
    "row_maps_to"
  ],
  "properties": {
    "source_type": {
      "type": "string"
    },
    "row_maps_to": {
      "enum": [
        "entity",
        "edge",
        "mixed"
      ]
    },
    "entity_type": {
      "enum": [
        "PERSON",
        "PHONE",
        "ACCOUNT",
        "VEHICLE",
        "ORG",
        "LOCATION"
      ]
    },
    "id_column": {
      "type": "string"
    },
    "attribute_columns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "aliases_column": {
      "type": "string"
    },
    "canonical_name_column": {
      "type": "string"
    },
    "entities": {
      "type": "array"
    },
    "relationship": {
      "$ref": "#/$defs/relationship"
    },
    "relationships": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relationship"
      }
    }
  },
  "$defs": {
    "relationship": {
      "type": "object",
      "required": [
        "type",
        "source_column",
        "target_column"
      ],
      "properties": {
        "type": {
          "enum": [
            "CALLED",
            "TRANSFERRED_TO",
            "OWNS",
            "ASSOCIATED_WITH",
            "NAMED_IN_FIR"
          ]
        },
        "source_column": {
          "type": "string"
        },
        "target_column": {
          "type": "string"
        },
        "weight_columns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "timestamp_column": {
          "type": "string"
        }
      }
    }
  }
}
