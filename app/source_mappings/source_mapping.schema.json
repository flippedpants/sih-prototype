{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SourceMapping",
  "type": "object",
  "required": ["source_type", "row_maps_to"],
  "properties": {
    "source_type": {"type": "string"},
    "row_maps_to": {"enum": ["entity", "edge", "mixed"]},
    "id_column_aliases": {"$ref": "#/$defs/aliases"},
    "canonical_name_aliases": {"$ref": "#/$defs/aliases"},
    "aliases_column_aliases": {"$ref": "#/$defs/aliases"},
    "attribute_column_aliases": {"type": "object", "additionalProperties": {"$ref": "#/$defs/aliases"}},
    "entities": {"type": "array"},
    "relationship": {"$ref": "#/$defs/relationship"},
    "relationships": {"type": "array", "items": {"$ref": "#/$defs/relationship"}}
  },
  "$defs": {
    "aliases": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "relationship": {
      "type": "object",
      "properties": {
        "source_column_aliases": {"$ref": "#/$defs/aliases"},
        "target_column_aliases": {"$ref": "#/$defs/aliases"},
        "weight_columns": {"type": "object"},
        "timestamp_column": {"type": "object"}
      }
    }
  }
}
